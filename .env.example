# Required reasoning provider
SEO_AGENT_GEMINI_API_KEY=
SEO_AGENT_GEMINI_MODEL=gemini-2.5-flash

# Optional providers; unavailable integrations become report warnings
SEO_AGENT_PAGESPEED_API_KEY=
SEO_AGENT_FIRECRAWL_API_KEY=

# Bounded audit configuration
SEO_AGENT_LIMITS__MAX_CANDIDATES=30
SEO_AGENT_LIMITS__MAX_SELECTED_PAGES=5
SEO_AGENT_LIMITS__MAX_PAGESPEED_PAGES=2
SEO_AGENT_LIMITS__MAX_INVESTIGATION_ROUNDS=1
SEO_AGENT_LIMITS__MAX_INVESTIGATION_FETCHES=2
SEO_AGENT_LIMITS__MAX_SITEMAP_FILES=3
SEO_AGENT_LIMITS__MAX_SITEMAP_URLS=500
SEO_AGENT_LIMITS__MAX_REDIRECTS=5
SEO_AGENT_LIMITS__MAX_RETRIES=2
SEO_AGENT_LIMITS__REQUEST_TIMEOUT_SECONDS=10
SEO_AGENT_LIMITS__PAGESPEED_TIMEOUT_SECONDS=45
SEO_AGENT_LIMITS__MAX_RESPONSE_BYTES=2097152
